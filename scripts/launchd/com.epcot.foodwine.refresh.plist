<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.epcot.foodwine.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/robluke/Documents/Code/Epcot/scripts/launchd/run_refresh.sh</string>
    </array>

    <!-- Daily, not weekly. Disney Food Blog publishes its per-booth photo
         posts a few booths at a time across the season rather than all at
         once, and each refresh attaches whatever has appeared since the last
         one. On a Sunday-only schedule a dish sits without its photo for up
         to six days after that photo is published. Omitting Weekday is what
         makes StartCalendarInterval fire every day. A quiet day costs two
         page fetches. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/robluke/Documents/Code/Epcot/logs/refresh.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/robluke/Documents/Code/Epcot/logs/refresh.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
